{
  "name": "golfgame-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:smoke": "esbuild smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/smoke.mjs --log-level=warning && node /tmp/smoke.mjs",
    "test:rejoin": "esbuild rejoin.ts --bundle --platform=node --format=esm --outfile=/tmp/rejoin.mjs --log-level=warning && node /tmp/rejoin.mjs"
  },
  "dependencies": {
    "spacetimedb": "2.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  }
}
